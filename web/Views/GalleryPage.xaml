<Page
    x:Class="ForzaGallerySync.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ForzaGallerySync.ViewModels">

    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12" RowDefinitions="Auto,*,Auto">

        <!-- ================= 工具栏 ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <!-- 详情模式下出现的返回按钮 -->
            <Button x:Uid="GalleryPage_TooltipBack" x:Name="BackBtn" Visibility="Collapsed"
                    Style="{StaticResource ToolbarButtonStyle}"
                    
                    Click="OnDetailClose">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <!-- 搜索 -->
            <AutoSuggestBox x:Uid="GalleryPage_PlaceholderText_00" x:Name="SearchBox" Grid.Column="1" Width="260"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged"
                            QuerySubmitted="OnSearchSubmitted" />

            <!-- 筛选与操作 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock Text="{x:Bind VM.TotalText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12" />
                <ComboBox x:Uid="GalleryPage_PlaceholderText_01" x:Name="GameCombo" MinWidth="172"
                          ItemsSource="{x:Bind VM.GamesList, Mode=OneWay}"
                          SelectionChanged="OnGameChanged" />
                <ComboBox x:Uid="GalleryPage_PlaceholderText_02" x:Name="MonthCombo" MinWidth="150"
                          ItemsSource="{x:Bind VM.Months, Mode=OneWay}"
                          SelectionChanged="OnMonthChanged" />
                <Button x:Uid="GalleryPage_TooltipRefresh" Style="{StaticResource ToolbarButtonStyle}"
                         Click="OnRefresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Uid="GalleryPage_TooltipOpenFolder" Style="{StaticResource ToolbarButtonStyle}"
                        IsEnabled="{x:Bind VM.HasDownloadDir, Mode=OneWay}"
                        
                        Click="OnOpenDownloadDir">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 照片网格 ================= -->
        <GridView Grid.Row="1" x:Name="PhotoGrid"
                  Style="{StaticResource PhotoGridStyle}"
                  ItemsSource="{x:Bind VM.Photos, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource PhotoGridItemStyle}"
                  ItemClick="OnPhotoClick"
                  SizeChanged="OnGridSizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="PhotoWrapGrid" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:PhotoItemViewModel">
                    <Grid Background="{ThemeResource AppImagePlaceholderBrush}"
                          CornerRadius="{StaticResource CardCornerRadius}">
                        <Image Source="{Binding Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom"
                                Height="46"
                                CornerRadius="0,0,8,8"
                                Background="{StaticResource AppThumbOverlayBrush}">
                            <StackPanel VerticalAlignment="Bottom" Padding="10,6" Spacing="1">
                                <TextBlock Text="{x:Bind GameName}" FontSize="10" Foreground="#B3FFFFFF" />
                                <TextBlock Text="{x:Bind Title, FallbackValue='无标题'}" FontSize="12"
                                           Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Border>

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="GalleryPage_Text_01" Click="OnMenuViewDetail">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="GalleryPage_Text_15" Click="OnMenuCopyImage">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="GalleryPage_Text_16" Click="OnMenuOpenWithDefault">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="GalleryPage_Text_09" Click="OnMenuOpenDir">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- ================= 加载 / 错误 / 空状态 ================= -->
        <Grid x:Name="StatusOverlay" Grid.Row="1" IsHitTestVisible="False">
            <ProgressRing Width="32" Height="32"
                          IsActive="{x:Bind VM.Loading, Mode=OneWay}"
                          Visibility="{x:Bind VM.Loading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="520">
                <TextBlock Text="{x:Bind VM.Error, Mode=OneWay}"
                           Foreground="{ThemeResource AppDangerBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{x:Bind VM.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <FontIcon Glyph="&#xEB9F;" FontSize="32"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Visibility="{x:Bind VM.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Uid="GalleryPage_Text_05" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                           Visibility="{x:Bind VM.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Uid="GalleryPage_Text_06"
                           Style="{StaticResource CaptionTextStyle}" TextAlignment="Center"
                           Visibility="{x:Bind VM.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- ================= 分页 ================= -->
        <StackPanel x:Name="Pager" Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Button x:Uid="GalleryPage_TooltipPrevPage" Style="{StaticResource PagerButtonStyle}"
                    IsEnabled="{x:Bind VM.HasPrev, Mode=OneWay}"
                     Click="OnPrevPage">
                <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>

            <ItemsControl ItemsSource="{x:Bind VM.PageButtons, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageButtonViewModel">
                        <Button Content="{x:Bind Label}" Tag="{x:Bind Page}"
                                Style="{StaticResource PagerButtonStyle}"
                                IsEnabled="{x:Bind IsCurrent, Converter={StaticResource InvertBool}}"
                                FontWeight="{x:Bind IsCurrent, Converter={StaticResource BoolToFontWeight}}"
                                Click="OnPageClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Uid="GalleryPage_TooltipNextPage" Style="{StaticResource PagerButtonStyle}"
                    IsEnabled="{x:Bind VM.HasNext, Mode=OneWay}"
                     Click="OnNextPage">
                <FontIcon Glyph="&#xE76C;" FontSize="12" />
            </Button>
        </StackPanel>

        <!-- ================= 照片详情（大图 + 信息栏并排） ================= -->
        <Grid x:Name="DetailView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 大图区 -->
            <Grid Grid.Column="0" x:Name="ImageArea"
                  Background="{ThemeResource AppImagePlaceholderBrush}"
                  CornerRadius="{StaticResource CardCornerRadius}">
                <Image x:Name="DetailImage" Stretch="Uniform" Margin="8">
                    <!-- 详情大图的右键菜单：与缩略图一致 -->
                    <Image.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="GalleryPage_Text_15" Click="OnDetailCopyImage">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="GalleryPage_Text_16" Click="OnDetailOpenFile">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="GalleryPage_Text_09" Click="OnDetailRevealInExplorer">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Image.ContextFlyout>
                </Image>

                <!-- 信息栏展开 / 收起（贴图片右缘，常驻可见） -->
                <Button x:Uid="GalleryPage_TooltipToggleInfo" x:Name="ToggleSidebarBtn"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="32" Height="56" Margin="0,0,10,0" Padding="0"
                        Click="OnToggleSidebar"
                        >
                    <FontIcon x:Name="ToggleSidebarIcon" Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </Grid>

            <!-- 信息栏 -->
            <Border x:Name="DetailSidebar" Grid.Column="1" Margin="16,0,0,0" RenderTransformOrigin="0.5,0.5"
                    Opacity="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border CornerRadius="{StaticResource PillCornerRadius}"
                                    Padding="8,3" VerticalAlignment="Top"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <TextBlock x:Name="DetailGame" FontSize="11" />
                            </Border>
                            <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="GalleryPage_Text_10" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock x:Name="DetailSubmitted" FontSize="13" />

                            <TextBlock x:Uid="GalleryPage_Text_11" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,4" />
                            <TextBlock x:Name="DetailDownloaded" FontSize="13" />

                            <TextBlock x:Uid="GalleryPage_Text_12" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,4" />
                            <TextBlock x:Name="DetailPhotoId" FontSize="12" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock x:Uid="GalleryPage_Text_13" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,4" />
                            <TextBlock x:Name="DetailPath" FontSize="12" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock x:Uid="GalleryPage_Text_14" Style="{StaticResource FieldLabelTextStyle}" Margin="0,10,0,4" />
                            <TextBlock x:Name="DetailDesc" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource CardDividerStyle}" />

                        <Button HorizontalAlignment="Stretch" Click="OnDetailCopyImage"
                                Style="{StaticResource IconTextButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock x:Uid="GalleryPage_Text_15" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch" Click="OnDetailOpenFile"
                                Style="{StaticResource IconTextButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock x:Uid="GalleryPage_Text_16" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 共享元素（Hero）转场动画层：打开详情时从缩略图放大，返回时缩小回缩略图。
             RenderTransform 由 HeroTransition 在运行时挂上。 -->
        <Image x:Name="HeroImage" Grid.RowSpan="3" Stretch="Uniform" Visibility="Collapsed"
               IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Page>
