<Page
    x:Class="ForzaGallerySync.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ForzaGallerySync.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20" Spacing="16">

            <!-- 加载指示 -->
            <ProgressRing Width="40" Height="40" HorizontalAlignment="Center" Margin="0,24,0,0"
                          IsActive="{x:Bind VM.Loading, Mode=OneWay}"
                          Visibility="{x:Bind VM.Loading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <!-- 错误提示 -->
            <TextBlock Text="{x:Bind VM.Error, Mode=OneWay}"
                       Foreground="{ThemeResource DangerBrush}"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind VM.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <!-- 统计卡片 -->
            <ItemsControl ItemsSource="{x:Bind VM.Stats, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="250" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatCardViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Width="52" Height="52" CornerRadius="10" Background="#2A2EA8FF">
                                    <TextBlock Text="{x:Bind Icon}" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Label}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 两列布局 -->
            <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="16">
                <!-- 左列：按游戏统计 + 最近同步 -->
                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="按游戏统计" FontWeight="SemiBold" FontSize="14" />
                            <ItemsControl ItemsSource="{x:Bind VM.GameBars, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameBarViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,6">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                       Width="150" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                                         Value="{x:Bind Percent}" VerticalAlignment="Center"
                                                         Foreground="{ThemeResource AccentBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无记录" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       Visibility="{x:Bind VM.GameBars.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="最近同步" FontWeight="SemiBold" FontSize="14" />
                            <ItemsControl ItemsSource="{x:Bind VM.SyncRows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SyncRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,8">
                                            <Border CornerRadius="4" Padding="8,3"
                                                    Background="{ThemeResource AccentBrush}">
                                                <TextBlock Text="{x:Bind GameName}" FontSize="11" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind LastSyncAt}" FontSize="13" />
                                                <TextBlock Text="{x:Bind Sub}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无同步记录" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       Visibility="{x:Bind VM.SyncRows.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右列：Token 状态 + 快速操作 + 配置概览 -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Token 状态" FontWeight="SemiBold" FontSize="14" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border CornerRadius="4" Padding="8,3" Background="#1F3DDC97"
                                        Visibility="{x:Bind VM.TokenStatusGood, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="有效" FontSize="11" Foreground="{ThemeResource SuccessBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="8,3" Background="#1FFF5C5C"
                                        Visibility="{x:Bind VM.TokenStatusGood, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                    <TextBlock Text="{x:Bind VM.TokenStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource DangerBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind VM.AccessTokenText, Mode=OneWay}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind VM.RefreshTokenText, Mode=OneWay}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <TextBlock Text="有效期" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind VM.ExpiresInText, Mode=OneWay}" FontSize="13"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <Button Content="前往设置" Click="OnGoSettings"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="快速操作" FontWeight="SemiBold" FontSize="14" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="🔄 开始同步" Click="OnGoSync" />
                                <Button Content="🖼️ 浏览照片库" Click="OnGoGallery" />
                                <Button Content="↻ 刷新" Click="OnRefresh" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="配置概览" FontWeight="SemiBold" FontSize="14" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                <TextBlock Text="下载目录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind VM.DownloadDir, Mode=OneWay}" FontSize="12"
                                           TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind VM.DownloadDir, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Text="数据库" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind VM.DatabasePath, Mode=OneWay}" FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="并发 / 分页" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind VM.ConcurrencyText, Mode=OneWay}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
