<Page
    x:Class="ForzaGallerySync.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ForzaGallerySync.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20" Spacing="16" HorizontalAlignment="Stretch">

            <!-- Token 卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="账号与 Token" FontWeight="SemiBold" FontSize="14" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="4" Padding="8,3" Background="#1F3DDC97"
                                Visibility="{x:Bind VM.TokenStatusGood, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="有效" FontSize="11" Foreground="{ThemeResource SuccessBrush}" />
                        </Border>
                        <Border CornerRadius="4" Padding="8,3" Background="#1FFF5C5C"
                                Visibility="{x:Bind VM.TokenStatusGood, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="{x:Bind VM.TokenStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource DangerBrush}" />
                        </Border>
                        <TextBlock Text="{x:Bind VM.Auth.MaskedToken, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="🌐 浏览器一键登录" Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="{x:Bind VM.IsLoggingIn, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                Click="OnLogin" />
                        <Button Content="↻ 刷新 Token"
                                IsEnabled="{x:Bind VM.Auth.HasRefreshToken, Mode=OneWay}"
                                Click="OnRefreshToken" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind VM.IsLoggingIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock Text="{x:Bind VM.LoginMsg, Mode=OneWay}" FontSize="13"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2"
                                Visibility="{x:Bind VM.IsLoggingIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="{x:Bind VM.LoginMsg, Mode=OneWay}" FontSize="13"
                                   Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>

                    <TextBlock Text="在弹出窗口中登录你的 Xbox / Microsoft 账号（支持两步验证），登录成功后 Token 会自动保存。" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 配置表单 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="同步设置" FontWeight="SemiBold" FontSize="14" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="14">
                        <!-- 下载目录（跨两列） -->
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
                            <TextBlock Text="下载目录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{x:Bind VM.DownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="📂 选择…" Click="OnPickDir" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="每页数量" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind VM.PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="分页方式" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{x:Bind VM.PaginationOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind VM.Pagination, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="并发线程数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind VM.Workers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <TextBlock Text="失败重试次数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind VM.Retries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="4">
                            <TextBlock Text="超时（秒）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind VM.Timeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                            <TextBlock Text="User-Agent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind VM.UserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- 启用游戏（跨两列） -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="6">
                            <TextBlock Text="启用游戏" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind VM.GameToggles, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameToggleViewModel">
                                        <ToggleButton Content="{x:Bind Name}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                      MinWidth="150" Margin="0,0,8,8" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ToggleSwitch Grid.Row="5" Grid.ColumnSpan="2" Header="验证 SSL 证书（关闭可绕过自签名证书问题）"
                                      IsOn="{x:Bind VM.VerifySsl, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="💾 保存" Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="{x:Bind VM.Saving, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                Click="OnSave" />
                        <Button Content="↻ 重新加载" Click="OnReload" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind VM.Error, Mode=OneWay}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind VM.OkMsg, Mode=OneWay}" Foreground="{ThemeResource SuccessBrush}" />
                </StackPanel>
            </Border>

            <!-- 关于与更新 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于与更新" FontWeight="SemiBold" FontSize="14" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="当前版本" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind VM.CurrentVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="🔍 检查更新"
                                IsEnabled="{x:Bind VM.CheckingUpdate, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                Click="OnCheckUpdate" />
                        <ProgressRing Width="16" Height="16" IsActive="True"
                                      Visibility="{x:Bind VM.CheckingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind VM.UpdateText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />

                    <Button Content="⬇ 打开下载页"
                            Visibility="{x:Bind VM.HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Click="OnOpenUpdate" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
