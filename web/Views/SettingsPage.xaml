<Page
    x:Class="ForzaGallerySync.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:ForzaGallerySync.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch">

            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="账号登录、存储位置、网络与并发等全局配置。"
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- ================= 账号与 Token ================= -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="账号与 Token" Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Center" />
                        <!-- 状态徽标 -->
                        <Border Grid.Column="1" CornerRadius="{StaticResource PillCornerRadius}"
                                Padding="8,3" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="12"
                                          Foreground="{x:Bind VM.TokenStatusGood, Mode=OneWay, Converter={StaticResource BoolToStatusBrush}}" />
                                <TextBlock Text="{x:Bind VM.TokenStatusText, Mode=OneWay}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{x:Bind VM.Auth.MaskedToken, Mode=OneWay}"
                               Style="{StaticResource FootnoteTextStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnLogin" Style="{StaticResource PrimaryActionButtonStyle}"
                                IsEnabled="{x:Bind VM.IsLoggingIn, Mode=OneWay, Converter={StaticResource InvertBool}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="14" />
                                <TextBlock Text="浏览器一键登录" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRefreshToken"
                                IsEnabled="{x:Bind VM.Auth.HasRefreshToken, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新 Token" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 登录进度 -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind VM.IsLoggingIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing Width="16" Height="16" IsActive="True" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind VM.LoginMsg, Mode=OneWay}" FontSize="13"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind VM.LoginMsg, Mode=OneWay}" FontSize="13"
                               Foreground="{ThemeResource AppSuccessBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind VM.IsLoggingIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <TextBlock Text="在弹出窗口中登录 Xbox / Microsoft 账号（支持两步验证），登录成功后 Token 会自动保存。"
                               Style="{StaticResource FootnoteTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ================= 存储 ================= -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="存储" Style="{StaticResource SectionTitleTextStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="下载目录" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{x:Bind VM.DownloadDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Click="OnPickDir">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="选择…" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 只读路径信息 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="数据库" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock Text="{x:Bind VM.DatabasePath, Mode=OneWay}" Style="{StaticResource InfoValueTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="配置文件" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,0,4" />
                        <TextBlock Text="{x:Bind VM.ConfigPath, Mode=OneWay}" Style="{StaticResource InfoValueTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= 网络与并发 ================= -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="网络与并发" Style="{StaticResource SectionTitleTextStyle}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="14">
                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock Text="每页数量" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind VM.PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Text="分页方式" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind VM.PaginationOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind VM.Pagination, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="并发线程数" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind VM.Workers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="失败重试次数" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind VM.Retries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock Text="超时（秒）" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind VM.Timeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                            <TextBlock Text="User-Agent" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{x:Bind VM.UserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <ToggleSwitch Header="验证 SSL 证书"
                                  OnContent="正常校验"
                                  OffContent="关闭（自签名证书时可绕过）"
                                  IsOn="{x:Bind VM.VerifySsl, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ================= 启用游戏 ================= -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="启用游戏" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="这里是默认同步范围；「同步」页可为单次任务临时改选。"
                               Style="{StaticResource FootnoteTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind VM.GameToggles, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameToggleViewModel">
                                <ToggleButton Content="{x:Bind Name}"
                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                              MinWidth="150" Margin="0,0,8,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= 保存 ================= -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Click="OnSave" Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="{x:Bind VM.Saving, Mode=OneWay, Converter={StaticResource InvertBool}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
                <Button Click="OnReload">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="重新加载" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 结果提示（用 InfoBar 之外的内联提示，避免与绑定冲突） -->
            <Border CornerRadius="{StaticResource CardCornerRadius}" Padding="12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="{x:Bind VM.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource AppDangerBrush}" />
                    <TextBlock Text="{x:Bind VM.Error, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource AppDangerBrush}" />
                </StackPanel>
            </Border>

            <Border CornerRadius="{StaticResource CardCornerRadius}" Padding="12"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="{x:Bind VM.HasOkMsg, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AppSuccessBrush}" />
                    <TextBlock Text="{x:Bind VM.OkMsg, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppSuccessBrush}" />
                </StackPanel>
            </Border>

            <!-- ================= 关于与更新 ================= -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于与更新" Style="{StaticResource SectionTitleTextStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="当前版本" Style="{StaticResource FootnoteTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind VM.CurrentVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnCheckUpdate"
                                IsEnabled="{x:Bind VM.CheckingUpdate, Mode=OneWay, Converter={StaticResource InvertBool}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="检查更新" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnDownloadUpdate"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                IsEnabled="{x:Bind VM.CanDownloadUpdate, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="下载并更新" />
                            </StackPanel>
                        </Button>
                        <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                      IsActive="{x:Bind VM.CheckingUpdate, Mode=OneWay}"
                                      Visibility="{x:Bind VM.CheckingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- 增量更新：只下载真正变化的文件，失败自动回退完整包 -->
                    <ToggleSwitch Header="优先增量更新"
                                  OnContent="只下载变化的文件"
                                  OffContent="每次下载完整包"
                                  IsOn="{x:Bind VM.PreferIncremental, Mode=TwoWay}"
                                  Visibility="{x:Bind VM.HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 下载进度：下载完成后会启动独立的替换脚本并自动退出应用 -->
                    <StackPanel Spacing="6"
                                Visibility="{x:Bind VM.Downloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Maximum="100" Value="{x:Bind VM.DownloadProgress, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind VM.UpdateActionMsg, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource AppBrandBrush}"
                               Visibility="{x:Bind VM.HasUpdateActionMsg, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="自动更新会先确认；增量模式只下载变化的文件并逐个校验 SHA256，不适用时自动回退完整包（完整包同样校验 SHA256）。校验通过才退出应用、覆盖程序文件并重启；哈希不匹配或拿不到官方清单时不会自动安装。"
                               Style="{StaticResource FootnoteTextStyle}"
                               Visibility="{x:Bind VM.HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 检查结果：可能较长（含降级原因），放进可滚动区域完整展示 -->
                    <Border CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="10,8" MaxHeight="150"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{x:Bind VM.UpdateText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>

                    <!-- 更新说明：CHANGELOG 章节，交给 CommunityToolkit 的 Markdown 控件渲染
                         （底层是开源的 Markdig，不会再显示 ### / ** 这类标记） -->
                    <Border CornerRadius="{StaticResource CardCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Padding="12" MaxHeight="260"
                            Visibility="{x:Bind VM.HasUpdateNotes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <controls:MarkdownTextBlock Text="{x:Bind VM.UpdateNotes, Mode=OneWay}"
                                                        FontSize="12"
                                                        IsTextSelectionEnabled="True"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </Border>

                    <Button Content="打开下载页" Click="OnOpenUpdate"
                            Visibility="{x:Bind VM.HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>