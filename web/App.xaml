<Application
    x:Class="ForzaGallerySync.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ForzaGallerySync.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 应用级设计令牌 / 语义色 / 卡片与文本样式 -->
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局转换器 -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
            <converters:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
            <converters:InvertBoolConverter x:Key="InvertBool" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:ResourceBrushConverter x:Key="ResourceBrush" />
            <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
