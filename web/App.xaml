<Application
    x:Class="ForzaGallerySync.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ForzaGallerySync.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局转换器 -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
            <converters:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
            <converters:InvertBoolConverter x:Key="InvertBool" />

            <!-- 应用级样式 / 资源 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#2EA8FF" />
            <SolidColorBrush x:Key="Accent2Brush" Color="#7B5CFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF5C5C" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFB020" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
