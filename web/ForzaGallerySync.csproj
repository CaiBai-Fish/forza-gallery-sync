<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ForzaGallerySync</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 不设置 PublishProfile：仓库没有 win-<Platform>.pubxml 配置文件，
         声明它只会产生 NETSDK1198 警告；发布参数由 web 下的打包脚本显式传入。 -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>forza-gallery-sync</AssemblyName>
    <ApplicationIcon>Assets\forza-gallery-sync.ico</ApplicationIcon>
    <!-- 独立 exe 模式：不打包 MSIX，也不需要系统预装 Windows App Runtime -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 需要保留的 WinUI/Windows App SDK 附属资源语言（见文件末尾的裁剪逻辑） -->
    <WinUILanguages>zh-CN;zh-TW;en-us</WinUILanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.Markdown" Version="7.1.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="pythonnet" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面文案资源（i18n）放在 Strings\<语言>\Resources.resw：
         .NET SDK 会**自动**把 Strings 下的 .resw 收进 PRIResource 并编进 resources.pri，
         不需要（也不能）在这里再显式声明 PRIResource —— 重复包含会报 NETSDK1022。
         不要放进 Resources\（那里是打包脚本与安装程序语言文件，属内嵌/构建资源）。 -->
    <Content Include="Assets\**\*" />
    <!-- 内嵌 Python 运行时（由 make-runtime.ps1 生成）作为开发/便携回退；不存在时跳过（干净检出可直接编译） -->
    <EmbeddedResource Include="python-runtime.zip" Condition="Exists('python-runtime.zip')" />
    <!-- 自动更新的替换脚本：以资源内嵌，运行时展开到临时目录再启动。
         独立成文件是为了避开 PowerShell 的 $ 与 C# 原始字符串插值语法的冲突。 -->
    <EmbeddedResource Include="Resources\apply-update.ps1" />
    <!-- 更新时运行安装程序的脚本（免安装版/安装版两种安装位置处理）。 -->
    <EmbeddedResource Include="Resources\run-installer.ps1" />
  </ItemGroup>

  <!-- ============================================================
        Assets 必须进发布目录
        ============================================================
        实测缺陷：<Content Include="Assets\**\*"/> 只让文件落进 bin，**进不了 publish 输出**
        （publish 走 ResolvedFileToPublish，而 Content 项在 WinUI 项目里默认不参与发布）。
        后果是发布版里没有 Assets\app-icon.png，主窗口标题栏那个
        <Image Source="Assets/app-icon.png"/> 加载不到 —— 表现为图标缺失。

        这里显式把 Assets 补进发布列表；用 RelativePath 保证落在 Assets\ 下。
        -->
  <Target Name="IncludeAssetsInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_AssetFile Include="$(MSBuildProjectDirectory)\Assets\**\*" />
      <ResolvedFileToPublish Include="@(_AssetFile)">
        <RelativePath>Assets\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Importance="normal" Text="Assets 发布项：@(_AssetFile->Count()) 个文件 → Assets\" />
  </Target>

  <!-- ============================================================
        发布目录裁剪：去掉用不到的 WinUI 语言资源（编译期完成）
        ============================================================
        自包含发布时，Windows App SDK 的 Microsoft.WindowsAppSDK.SelfContained.targets
        用通配符把所有附属资源都收进复制列表：

            <MicrosoftWindowsAppSDKFiles Include="$(MicrosoftWindowsAppSDKMsixContent)\**\*.mui"/>
            <MicrosoftWindowsAppSDKFiles Remove="@(MicrosoftWindowsAppSDKFilesExcluded)"/>

        其中 `*.mui` 覆盖了 80+ 种语言，每个语言一个目录（实测 83 个目录 / 166 个文件
        / 3.3 MB，每个只含 Microsoft.ui.xaml.dll.mui 之类），发布目录看起来极乱。

        注意 <SatelliteResourceLanguages> 在这里**不起作用**：它管的是 .NET 附属程序集，
        而这些 .mui 由上面那条通配符复制，不经过 .NET 的资源机制。

        ★ 排除项必须在 Target 里录入，不能写成顶层 ItemGroup：`$(MicrosoftWindowsAppSDKMsixContent)`
          在项目求值阶段还没有值，通配符会退化成 `\**\*.mui`（MSB5029，甚至可能枚举整个驱动器）。

        ⚠️ 不要试图把语言目录或 .NET 程序集"移动"到 runtime/、resources/ 之类的子目录：
          这些路径是平台硬编码的，实测会直接崩溃（换 SDK 版本后建议复测）：
            - 语言目录挪到 resources\lang\ → WinUI: COMException「资源加载器缓存没有已加载的 MUI 项」
            - 托管程序集挪到 runtime\      → .NET 主机在托管代码前退出（0x80008009 / 0xE0434352）
          所以发布目录的扁平布局是平台约束，只能靠"减少文件"而非"重新分类"来改善。
        -->
  <Target Name="ExcludeUnusedWinUILanguages"
          AfterTargets="ExtractMicrosoftWindowsAppSDKMsixFiles"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFiles">
    <ItemGroup>
      <_WinUIMui Include="$(MicrosoftWindowsAppSDKMsixContent)\**\*.mui" />
      <!-- 保留哪些语言：用「语言目录名 == 目标语言」直接比较 RecursiveDir。
           MSBuild 的项匹配有两个坑，都实测踩过：
             1) Condition 里写 `@(WinUIKeepLanguage)`（项列表）会被当成 `zh-CN;zh-TW;en-us`
                这一整串，永远不会等于单个目录名，结果把要保留的也排掉了；
             2) `Exclude="%(Identity)\**\*.mui"` 这类相对模式匹配不上绝对路径的候选集。
           所以这里退回到最朴素的一对一比较，可读且行为确定。
           语言清单与 $(WinUILanguages) 保持一致（改这里时记得同步那个属性与 README）。 -->
      <_WinUIMuiKeep Include="@(_WinUIMui)"
                     Condition="'%(RecursiveDir)' == 'zh-CN\' Or '%(RecursiveDir)' == 'zh-TW\' Or '%(RecursiveDir)' == 'en-us\'" />
      <_WinUIMuiUnused Include="@(_WinUIMui)" Exclude="@(_WinUIMuiKeep)" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="@(_WinUIMuiUnused)" />
    </ItemGroup>
    <Message Importance="normal"
             Text="WinUI 语言资源裁剪：候选 @(_WinUIMui->Count()) 个 .mui，保留 @(_WinUIMuiKeep->Count()) 个，排除 @(_WinUIMuiUnused->Count()) 个（$(WinUILanguages)）" />
  </Target>

  <!-- 兜底断言：裁剪依赖 Windows App SDK 的 MicrosoftWindowsAppSDKFilesExcluded 扩展点。
       若某个 SDK 版本不再提供该扩展点，裁剪会静默失效、80+ 个语言目录重新回到发布目录，
       所以这里检查**最终输出目录**（而不是 SDK 的解压缓存——那里永远是全部语言，用它判断
       必然误报），让问题在构建时暴露，而不是等用户看到乱目录。

       ★ 判定方式要"取出多余语言目录"，不要用 Exclude 里的相对通配模式：
         `Exclude="$(OutDir)zh-CN\**\*.mui"` 这种写法在 $(OutDir) 带正斜杠/尾部斜杠时匹配不上，
         结果把**要保留的** .mui 也算成多余、每次都误报（实测踩过）。
         另外 Windows App SDK 会为每种语言建一个空目录，所以必须按"目录里有 .mui"来判断；
         而 $(OutDir) 下面还有 RID 子目录（bin\<cfg>\<tfm>\win-x64\zh-CN\），
         所以匹配时要同时认这两种层级，否则又变成误报。 -->
  <Target Name="VerifyWinUILanguageTrim" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_OutMui Include="$(OutDir)**\*.mui" />
      <_OutMuiKeep Include="@(_OutMui)"
                   Condition="'%(RecursiveDir)' == 'zh-CN\' Or '%(RecursiveDir)' == 'zh-TW\' Or '%(RecursiveDir)' == 'en-us\'
                              Or '%(RecursiveDir)' == 'win-x64\zh-CN\' Or '%(RecursiveDir)' == 'win-x64\zh-TW\' Or '%(RecursiveDir)' == 'win-x64\en-us\'" />
      <_OutMuiExtra Include="@(_OutMui)" Exclude="@(_OutMuiKeep)" />
    </ItemGroup>
    <Warning Condition="'@(_OutMuiExtra)' != ''"
             Text="语言资源裁剪未生效：$(OutDir) 下有 @(_OutMuiExtra->Count()) 个多余的 .mui（例如 %(_OutMuiExtra.RecursiveDir)）；依赖 MicrosoftWindowsAppSDKFilesExcluded，该 Windows App SDK 版本可能已改变实现" />
  </Target>

</Project>
