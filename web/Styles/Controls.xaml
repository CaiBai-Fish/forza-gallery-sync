<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         应用级设计资源
         颜色全部走 ThemeDictionaries，浅色与深色主题下都保证对比度。
         本文件只包含样式 / 画刷 / 设计令牌，不定义自定义控件类型。
         ===================================================================== -->

    <!-- 语义色 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBrandBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F7B4F" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="AppImagePlaceholderBrush" Color="#0F000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBrandBrush" Color="#6CB8FF" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#6CB8FF" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB9B" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#F0B429" />
            <SolidColorBrush x:Key="AppImagePlaceholderBrush" Color="#1AFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 缩略图底部的渐变遮罩：用渐变代替纯黑块，文字始终可读且观感更轻 -->
    <LinearGradientBrush x:Key="AppThumbOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="1" Color="#D9000000" />
    </LinearGradientBrush>

    <!-- =====================================================================
         设计令牌
         ===================================================================== -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">4</CornerRadius>
    <Thickness x:Key="PageMargin">24,20,24,28</Thickness>

    <!-- =====================================================================
         文本样式
         ===================================================================== -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="FootnoteTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- =====================================================================
         卡片
         ===================================================================== -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CardDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style x:Key="StatIconBoxStyle" TargetType="Border">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="StatValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- =====================================================================
         按钮
         ===================================================================== -->
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="IconTextButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PagerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="MinWidth" Value="36" />
    </Style>

    <!-- =====================================================================
         照片网格
         ===================================================================== -->
    <Style x:Key="PhotoGridItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="PhotoGridStyle" TargetType="GridView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
    </Style>

    <!-- =====================================================================
         只读信息值（设置页展示数据库 / 配置文件路径）
         ===================================================================== -->
    <Style x:Key="InfoValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

</ResourceDictionary>
