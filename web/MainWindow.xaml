<Window
    x:Class="ForzaGallerySync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Forza Gallery Sync 控制台">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             自定义标题栏：应用图标 + 应用名 + 全局同步状态
             左侧留白按标题栏按钮的标准内缩（80px，见 WindowEx时由代码调整），
             让图标与标题和系统标题栏的按钮对齐，而不是贴着窗口边缘。
             ============================================================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="20,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- 应用图标（从 Assets\forza-gallery-sync.ico 提取的 256px 条目） -->
                <Image Source="Assets/app-icon.png" Width="20" Height="20" />
                <TextBlock x:Name="AppTitleText"
                           Text="Forza Gallery Sync"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 全局状态区：同步进行中时亮起，任何页面都能看到 -->
            <StackPanel x:Name="TitleStatusPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing x:Name="TitleStatusRing" Width="14" Height="14" IsActive="False" />
                <FontIcon x:Name="TitleStatusIcon" Glyph="&#xE7BA;" FontSize="12"
                          Foreground="{ThemeResource AppWarnBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="TitleStatusText" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================================================
             主导航：左导航（分组）+ 内容 Frame
             ============================================================ -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        OpenPaneLength="248"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <!-- 组 1：浏览与统计 -->
                <NavigationViewItemHeader Content="图库" />

                <NavigationViewItem Content="总览" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="照片库" Tag="gallery">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 组 2：任务与配置 -->
                <NavigationViewItemHeader Content="任务" />

                <NavigationViewItem Content="同步" Tag="sync">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 页脚：账号状态常驻显示，点击直达设置 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AccountItem"
                                    Content="未登录"
                                    Tag="settings"
                                    ToolTipService.ToolTip="点击前往设置页配置 Token">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="AccountIcon" Glyph="&#xE7BA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
