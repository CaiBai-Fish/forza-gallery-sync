{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forza Gallery Sync",
  "version": "0.2.1",
  "identifier": "com.forza.gallerysync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forza Gallery Sync 控制台",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../runtime/python313.dll": "python313.dll",
      "../runtime/python3.dll": "python3.dll",
      "../runtime/msvcp140.dll": "msvcp140.dll",
      "../runtime/vcruntime140.dll": "vcruntime140.dll",
      "../runtime/vcruntime140_1.dll": "vcruntime140_1.dll",
      "../runtime/Lib": "python/Lib",
      "../runtime/DLLs": "python/DLLs",
      "../runtime/Library": "python/Library"
    }
  }
}
