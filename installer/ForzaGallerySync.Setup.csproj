<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>ForzaGallerySync.Setup</RootNamespace>
    <AssemblyName>ForzaGallerySync-Setup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.4.1</Version>
    <ApplicationIcon>forza-gallery-sync.ico</ApplicationIcon>
    <!-- 单文件自包含安装程序：不依赖目标机器上的 .NET 运行时 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      应用负载（WinUI 应用 + .NET runtime + Python runtime）由 web\make-installer.ps1
      生成并写入本目录 payload.zip，构建时作为资源嵌入安装程序。
      不存在时跳过（例如单独 dotnet build 该工程），运行时会给出明确提示。
    -->
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

</Project>
