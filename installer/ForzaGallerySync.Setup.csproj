<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>ForzaGallerySync.Setup</RootNamespace>
    <AssemblyName>ForzaGallerySync-Setup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.4.2</Version>
    <ApplicationIcon>forza-gallery-sync.ico</ApplicationIcon>
    <!-- 单文件自包含安装程序：不依赖目标机器上的 .NET 运行时 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      应用负载（WinUI 应用 + .NET runtime + Python runtime）由 web\make-installer.ps1
      生成并写入本目录 payload.zip，构建时作为资源嵌入安装程序。
      不存在时跳过（例如单独 dotnet build 该工程），运行时会给出明确提示。
    -->
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

  <!-- msi\ 是独立的 MSI 打包工程（installer\msi\customaction：DTF 托管自定义动作），
       必须从本项目的默认编译/资源通配（**/*.cs 等）中排除，否则会把
       CustomActions.cs 一并编译导致 CS0246（Setup 项目未引用 DTF 程序集）。 -->
  <ItemGroup>
    <Compile Remove="msi\**" />
    <EmbeddedResource Remove="msi\**" />
    <None Remove="msi\**" />
    <Content Remove="msi\**" />
  </ItemGroup>

</Project>
